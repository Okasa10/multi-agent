# ==========================================
# AI Recruiter Assistant - Configuration
# ==========================================
# The system operates 100% offline using a deterministic NLP engine if no API keys are provided.
# If you wish to enable live LLM reasoning, provide ONE of the API keys below.

# Option 1: Groq API Key (Fast & Free tier available at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
